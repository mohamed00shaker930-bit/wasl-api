NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://wasl:wasl@127.0.0.1:55432/wasl_dev

# JWT: generate with `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false
# comma-separated; leave empty in production (same origin behind Caddy)
CORS_ORIGINS=http://localhost:5173

# files: minio | disk
STORAGE_DRIVER=disk
DISK_STORAGE_ROOT=./.files
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# public base for stored files (Caddy /files/* -> MinIO, or the API's /api/files when STORAGE_DRIVER=disk)
S3_PUBLIC_BASE_URL=http://localhost:3000/api/files

# first super admin (used once by `pnpm db:seed`)
SEED_SUPER_ADMIN_PHONE=770000000
SEED_SUPER_ADMIN_PASSWORD=change-me-now
